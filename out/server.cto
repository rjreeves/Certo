fn handleCreateSubscriberPost(req: HttpRequest): HttpResponse = {
    val body = HttpRequest.body(req)
    val conn = dbConnect(dbUrl)
    val custNo = formField(body, "custNo")
    val subNo = formField(body, "subNo")
    val subsName = formField(body, "subsName")
    val subsName1 = formField(body, "subsName1")
    val subsName2 = formField(body, "subsName2")
    val subsAddress1 = formField(body, "subsAddress1")
    val subsAddress2 = formField(body, "subsAddress2")
    val subsTown = formField(body, "subsTown")
    val subsPostcode = formField(body, "subsPostcode")
    val subsEmail = formField(body, "subsEmail")
    val subActive = formField(body, "subActive")
    val subsStatus = formField(body, "subsStatus")
    val _p0 = List.empty
    val _p1 = List.push(_p0, custNo)
    val _p2 = List.push(_p1, subNo)
    val _p3 = List.push(_p2, subsName)
    val _p4 = List.push(_p3, subsName1)
    val _p5 = List.push(_p4, subsName2)
    val _p6 = List.push(_p5, subsAddress1)
    val _p7 = List.push(_p6, subsAddress2)
    val _p8 = List.push(_p7, subsTown)
    val _p9 = List.push(_p8, subsPostcode)
