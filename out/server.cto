module FireworksUIServer

import Stdlib.Core
import Stdlib.Http
import Stdlib.Db

val dbUrl = getEnv("DATABASE_URL") ?? "host=localhost dbname=postgres user=postgres"

// ── CSS + page shell ─────────────────────────────────────────────────────────
val htmlCss: Text =
    "<style>" ++
    "body{font-family:sans-serif;margin:2rem;color:#222;}" ++
    "h1{font-size:1.5rem;margin-bottom:1rem;}" ++
    "nav{margin-bottom:1.5rem;}" ++
    "nav a{margin-right:1rem;color:#0066cc;text-decoration:none;}" ++
    "table{border-collapse:collapse;width:100%;margin-top:0.5rem;}" ++
    "th,td{border:1px solid #ccc;padding:6px 12px;text-align:left;font-size:0.9rem;}" ++
    "th{background:#f0f0f0;font-weight:600;}" ++
    "tr:nth-child(even) td{background:#fafafa;}" ++
    ".field{margin-bottom:1rem;}" ++
    "label{display:block;font-weight:bold;margin-bottom:0.25rem;}" ++
    "input,select,textarea{padding:0.4rem;border:1px solid #ccc;border-radius:4px;width:100%;max-width:420px;box-sizing:border-box;}" ++
    "button{padding:0.5rem 1.25rem;background:#0066cc;color:#fff;border:none;border-radius:4px;cursor:pointer;margin-top:0.5rem;}" ++
    "a.btn{display:inline-block;padding:0.4rem 1rem;background:#0066cc;color:#fff;border-radius:4px;text-decoration:none;font-size:0.9rem;}" ++
    "</style>"

fn htmlPage(title: Text, body: Text): Text =
    "<!DOCTYPE html><html lang=\"en\"><head>" ++
    "<meta charset=\"UTF-8\">" ++
    "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">" ++
    "<title>" ++ title ++ "</title>" ++
    htmlCss ++
    "</head><body>" ++ body ++ "</body></html>"

// ── HTML table helpers ───────────────────────────────────────────────────────
fn htmlTh(cols: List<Text>, i: Int, n: Int, acc: Text): Text =
    if i >= n then acc
    else htmlTh(cols, i + 1, n, acc ++ "<th>" ++ List.getOrPanic(cols, i) ++ "</th>")

fn htmlTd(row: List<Text?>, i: Int, n: Int, acc: Text): Text =
    if i >= n then acc
    else htmlTd(row, i + 1, n, acc ++ "<td>" ++ (List.getOrPanic(row, i) ?? "") ++ "</td>")

fn htmlTr(rows: List<List<Text?>>, i: Int, n: Int, acc: Text): Text =
    if i >= n then acc
    else {
        val row = List.getOrPanic(rows, i)
        htmlTr(rows, i + 1, n, acc ++ "<tr>" ++ htmlTd(row, 0, List.len(row), "") ++ "</tr>")
    }

fn htmlTable(cols: List<Text>, rows: List<List<Text?>>): Text =
    "<table><thead><tr>" ++ htmlTh(cols, 0, List.len(cols), "") ++
    "</tr></thead><tbody>" ++ htmlTr(rows, 0, List.len(rows), "") ++ "</tbody></table>"

// ── URL-encoded form body parsing ────────────────────────────────────────────
fn formField(body: Text, name: Text): Text =
    formFieldAt(Text.split(body, "&"), name, 0)

fn formFieldAt(parts: List<Text>, name: Text, i: Int): Text =
    if i >= List.len(parts) then ""
    else {
        val kv = Text.split(List.getOrPanic(parts, i), "=")
        if List.len(kv) >= 2 and Text.eq(List.getOrPanic(kv, 0), name)
        then List.getOrPanic(kv, 1)
        else formFieldAt(parts, name, i + 1)
    }

// ── Router ───────────────────────────────────────────────────────────────────
fn handler(req: HttpRequest): HttpResponse = {
    val path   = HttpRequest.path(req)
    val method = HttpRequest.method(req)
    if path == "/customer-list" then handleCustomerList(req)
    else if path == "/customer-detail" then handleCustomerDetail(req)
    else if path == "/subscriber-list" then handleSubscriberList(req)
    else if path == "/subscriber-detail" then handleSubscriberDetail(req)
    else if path == "/subscription-list" then handleSubscriptionList(req)
    else if path == "/product-list" then handleProductList(req)
    else if path == "/create-customer" then
        if method == "POST" then handleCreateCustomerPost(req)
        else handleCreateCustomerGet(req)
    else if path == "/edit-customer" then
        if method == "POST" then handleEditCustomerPost(req)
        else handleEditCustomerGet(req)
    else if path == "/create-subscriber" then
        if method == "POST" then handleCreateSubscriberPost(req)
        else handleCreateSubscriberGet(req)
    else if path == "/edit-subscriber" then
        if method == "POST" then handleEditSubscriberPost(req)
        else handleEditSubscriberGet(req)
    else if path == "/create-subscription" then
        if method == "POST" then handleCreateSubscriptionPost(req)
        else handleCreateSubscriptionGet(req)
    else if path == "/edit-subscription" then
        if method == "POST" then handleEditSubscriptionPost(req)
        else handleEditSubscriptionGet(req)
    else if path == "/create-product" then
        if method == "POST" then handleCreateProductPost(req)
        else handleCreateProductGet(req)
    else if path == "/edit-product" then
        if method == "POST" then handleEditProductPost(req)
        else handleEditProductGet(req)
    else Http.notFound(f"No route for {method} {path}")
}

// ── CustomerList ─────────────────────────────────────────────────────────────────────
fn handleCustomerList(req: HttpRequest): HttpResponse = {
    val conn = dbConnect(dbUrl)
    val sql  = "SELECT * FROM customer ORDER BY 1"
    val cols = dbColumns(conn, sql)
    val rows = dbQuery(conn, sql, List.empty)
    dbClose(conn)
    val body = "<h1>Customer List</h1>" ++
        "<nav><a href=\"/create-customer\" class=\"btn\">New customer</a></nav>" ++
        htmlTable(cols, rows)
    Http.ok(htmlPage("Customer List", body), "text/html")
}

// ── CustomerDetail ─────────────────────────────────────────────────────────────────────
fn handleCustomerDetail(req: HttpRequest): HttpResponse =
    Http.ok(htmlPage("Customer Detail", "<h1>Customer Detail</h1><div class=\"vstack\">  <h2>Customer Detail</h2>  <div class=\"hstack\">    <button hx-get=\"/customer/edit\" hx-swap=\"outerHTML\">Edit</button>    <button hx-get=\"/customers\" hx-swap=\"outerHTML\">Back</button>  </div>  <div class=\"vstack\">    <h2>Account</h2>    <p>Account Name</p>    <p>Account No</p>    <p>Type</p>    <p>Status</p>  </div>  <div class=\"vstack\">    <h2>Name &amp; Address</h2>    <p>Name</p>    <p>Address</p>    <p>Town</p>    <p>Postcode</p>  </div>  <div class=\"vstack\">    <h2>Contact</h2>    <p>Phone</p>    <p>Email</p>  </div>  <div class=\"vstack\">    <h2>Billing</h2>    <p>Bill Cycle</p>    <p>Next Bill</p>    <p>Credit Code</p>    <p>Limit</p>  </div></div>"), "text/html")

