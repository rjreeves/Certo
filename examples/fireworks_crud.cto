module FireworksCrud

// ---------------------------------------------------------------------------
// Fireworks CRUD UI — Customer, Subscriber, Subscription
// Compiled with: certo-ui fireworks_crud.cto -o out/fireworks
// ---------------------------------------------------------------------------

// ============================================================
// HOME
// ============================================================

view Home {
    layout = VStack(children: [
        Heading("Fireworks"),
        HStack(children: [
            Button("Customers",     "/customers"),
            Button("Subscribers",   "/subscribers"),
            Button("Subscriptions", "/subscriptions"),
        ])
    ])
}

// ============================================================
// CUSTOMER
// ============================================================

view CustomerList {
    layout = VStack(children: [
        Heading("Customers"),
        HStack(children: [
            Button("New Customer", "/customers/new"),
            Link("Home", "/"),
        ]),
        Button("View All Customers", "/customers"),
    ])
}

view CustomerDetail {
    layout = VStack(children: [
        Heading("Customer Detail"),
        HStack(children: [
            Button("Edit",   "/customers/edit"),
            Button("Delete", "/customers/delete"),
            Link("Back to Customers", "/customers"),
        ]),
        Text("Account Name:"),
        Text("Customer No:"),
        Text("Type:"),
        Text("Status:"),
        Text("Name 1:"),
        Text("Name 2:"),
        Text("Address 1:"),
        Text("Address 2:"),
        Text("Town:"),
        Text("Postcode:"),
        Text("Mail Code:"),
        Text("Contact:"),
        Text("Phone:"),
        Text("Email:"),
        Text("E-Billing:"),
        Text("Print Invoice:"),
        Text("Bill Cycle:"),
        Text("Next Bill Date:"),
        Text("Credit Code:"),
        Text("Credit Limit:"),
        Text("Dunning:"),
        Text("Carried Forward:"),
    ])
}

view CustomerNew {
    layout = VStack(children: [
        Heading("New Customer"),
        Link("Cancel", "/customers"),
        Button("Save Customer", "/customers/create"),
    ])
}

view CustomerEdit {
    layout = VStack(children: [
        Heading("Edit Customer"),
        Link("Cancel", "/customers"),
        HStack(children: [
            Button("Save",   "/customers/update"),
            Button("Delete", "/customers/delete"),
        ]),
    ])
}

