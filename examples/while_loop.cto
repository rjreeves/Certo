// While loop examples
module WhileLoop

import Stdlib.Core

fn countdown(n: Int): Unit [io] = {
    var i = n
    while i > 0 {
        println(intToText(i))
        i = i - 1
    }
}

fn sumUpTo(limit: Int): Int = {
    var total = 0
    var i = 1
    while i <= limit {
        total = total + i
        i = i + 1
    }
    total
}

fn main(): Unit [io] = {
    countdown(5)
    val s = sumUpTo(10)
    println(intToText(s))
}
