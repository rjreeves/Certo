/* ---- arithmetic ---- */

int64_t certo_pow(int64_t base, int64_t exp) {
    if (exp < 0) return 0;
    int64_t result = 1;
    while (exp > 0) {
        if (exp & 1) result *= base;
        base *= base;
        exp >>= 1;
    }
    return result;
}

int64_t certo_abs_int(int64_t n)   { return n < 0 ? -n : n; }
double  certo_abs_float(double f)  { return f < 0.0 ? -f : f; }
