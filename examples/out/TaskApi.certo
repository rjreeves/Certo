module TaskApi

// REST client generated by certo-ffi — do not edit
// Base URL: https://api.example.com
// Auth: bearer

// GET /tasks
pub fn listTasks(page: Int?, done: Bool?): List<Task> [async, io] =
  http_get("https://api.example.com/tasks", [("page", page), ("done", done)])

// GET /tasks/{id}
pub fn getTask(id: Int): Task [async, io] =
  http_get("https://api.example.com/tasks/" ++ id.toString())

// POST /tasks
pub fn createTask(body: CreateTaskRequest): Task [async, io] =
  http_post("https://api.example.com/tasks", body)

// PUT /tasks/{id}/complete
pub fn completeTask(id: Int): Task [async, io] =
  http_put("https://api.example.com/tasks/" ++ id.toString() ++ "/complete", ())

// DELETE /tasks/{id}
pub fn deleteTask(id: Int): Unit [async, io] =
  http_delete("https://api.example.com/tasks/" ++ id.toString())
