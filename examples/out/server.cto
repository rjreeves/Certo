// ── ProductList ─────────────────────────────────────────────────────────────────────
fn handleProductList(req: HttpRequest): HttpResponse = {
    val conn = dbConnect(dbUrl())
    val sql  = "SELECT * FROM product ORDER BY 1"
    val cols   = dbColumns(conn, sql)
