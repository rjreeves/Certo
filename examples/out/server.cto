        "<input id=\"custName1\" name=\"custName1\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custName2\">custName2</label>" ++
        "<input id=\"custName2\" name=\"custName2\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custAddress1\">custAddress1</label>" ++
        "<input id=\"custAddress1\" name=\"custAddress1\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custAddress2\">custAddress2</label>" ++
        "<input id=\"custAddress2\" name=\"custAddress2\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custTown\">custTown</label>" ++
        "<input id=\"custTown\" name=\"custTown\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custPostcode\">custPostcode</label>" ++
        "<input id=\"custPostcode\" name=\"custPostcode\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custContact\">custContact</label>" ++
        "<input id=\"custContact\" name=\"custContact\" type=\"text\" required></div>" ++
        "<div class=\"field\"><label for=\"custPhone\">custPhone</label>" ++
        "<input id=\"custPhone\" name=\"custPhone\" type=\"tel\" required></div>" ++
        "<div class=\"field\"><label for=\"custEmail\">custEmail</label>" ++
        "<input id=\"custEmail\" name=\"custEmail\" type=\"email\" required></div>" ++
        "<div class=\"field\"><label for=\"custBillCycle\">custBillCycle</label>" ++
