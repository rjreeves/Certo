// A generic function's return type must be pinned by an annotation at the
// call site (error E0601 otherwise) - see docs/ERROR-REFERENCE.md.
module GenericTest

import Stdlib.Core

fn identity<T>(x: T): T = x

fn first<T>(xs: List<T>): T? = List.first(xs)

fn main(): Unit [io] = {
    val n: Int = identity(42)
    val s: Text = identity("hello")
    println(intToText(n))
    println(s)
    val nums = [1, 2, 3]
    val f: Int? = first(nums)
    println(intToText(f ?? 0))
}
