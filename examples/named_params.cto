// Named and optional parameters
module NamedParams

import Stdlib.Core

fn connect(host: Text, port: Int = 5432, ssl: Bool = false): Text =
    f"{host}:{intToText(port)} ssl={boolToText(ssl)}"

fn main(): Unit [io] = {
    // Positional (classic)
    println(connect("localhost", 5432, false))

    // Named args - any order
    println(connect(host: "db.prod.example.com", ssl: true))

    // Mix: positional first, then named
    println(connect("localhost", ssl: true))
}
