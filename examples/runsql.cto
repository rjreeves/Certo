module runsql

// ---------------------------------------------------------------------------
// runsql — execute a SQL file against PostgreSQL, like `psql -f file.sql`,
// but as a single self-contained binary (no psql / PostgreSQL client install
// required — libpq is linked/shipped with the executable).
//
// Usage:
//   runsql <file.sql> [connstr]
//
//   connstr defaults to $PG_CONNSTR, then to libpq's own environment
//   variables (PGHOST, PGPORT, PGDATABASE, PGUSER, PGPASSWORD) and defaults.
//
// Output: the file being processed and the elapsed execution time.
//
// Errors abort with a report, in two levels:
//   [file]   — level 1: SQL file cannot be found, opened, or read.
//   [server] — level 2: connection or runtime execution error from PostgreSQL.
//
// Works against PostgreSQL 9.1 and above (uses the simple query protocol, and
// a modern libpq so SCRAM-authenticated 10+ servers connect too).
// ---------------------------------------------------------------------------

import Stdlib.Core
import Stdlib.Text
import Stdlib.File
import Stdlib.Db
import Stdlib.Env
import Stdlib.Process

fn fail1(msg: Text): Unit [io] = {
    eprintln("ERROR [file]: " ++ msg)
    Process.quit(1)
}

fn fail2(msg: Text): Unit [io] = {
    eprintln("ERROR [server]: " ++ msg)
    Process.quit(2)
}

// ── Table rendering (psql-style aligned columns with a header) ──────────────

fn padRight(s: Text, w: Int): Text = {
    var out = s
    var n = w - Text.len(s)
    while n > 0 {
        out = out ++ " "
        n = n - 1
    }
    out
}

fn rowToText(row: List<Text?>): List<Text> = {
    var out: List<Text> = []
    for c in row {
        out = List.push(out, c ?? "")
    }
    out
}

fn joinCells(cells: List<Text>, widths: List<Int>, sep: Text): Text = {
    var line = ""
    var i = 0
    val n = List.len(widths)
    while i < n {
        val padded = padRight(List.getOrPanic(cells, i), List.getOrPanic(widths, i))
        if i == 0 then { line = padded } else { line = line ++ sep ++ padded }
        i = i + 1
    }
    line
}

fn sepLine(widths: List<Int>): Text = {
    var line = ""
    var i = 0
    val n = List.len(widths)
    while i < n {
        val dashes = Text.repeat("-", List.getOrPanic(widths, i))
        if i == 0 then { line = dashes } else { line = line ++ "-+-" ++ dashes }
        i = i + 1
    }
    line
}

fn printTable(cols: List<Text>, rows: List<List<Text?>>, elapsedMs: Int): Unit [io] = {
    val ncol = List.len(cols)

    // Column widths = max(header, widest cell in that column).
    var widths: List<Int> = []
    var i = 0
    while i < ncol {
        var w = Text.len(List.getOrPanic(cols, i))
        for row in rows {
            val cl = Text.len(List.getOrPanic(row, i) ?? "")
            if cl > w then { w = cl }
        }
        widths = List.push(widths, w)
        i = i + 1
    }

    println(joinCells(cols, widths, " | "))
    println(sepLine(widths))
    for row in rows {
        println(joinCells(rowToText(row), widths, " | "))
    }
    println(f"({intToText(List.len(rows))} rows, {intToText(elapsedMs)} ms)")
}

fn runSql(file: Text, connstr: Text, sql: Text): Unit [io] = {
    val conn = dbConnect(connstr)
    if conn == 0 then {
        fail2("cannot connect: " ++ dbError(0))
    }

    val start = monotonicMillis()
    val result = dbRunScriptResult(conn, sql)
    val elapsed = monotonicMillis() - start

    if not DbResult.ok(result) then {
        val err = DbResult.error(result)   // capture before closing
        dbClose(conn)
        fail2(err)
    }

    // If the final statement produced a result set, print it as a table with a
    // "(N rows, T ms)" summary; otherwise just report completion + time.
    val cols = DbResult.columns(result)
    if List.len(cols) > 0 then {
        printTable(cols, DbResult.rows(result), elapsed)
    } else {
        println(f"Done: {file}  ({intToText(elapsed)} ms)")
    }

    dbClose(conn)
}

fn main(): Unit [io] = {
    val file = arg(1) ?? ""
    if Text.eq(file, "") then {
        eprintln("usage: runsql <file.sql> [connstr]")
        eprintln("  connstr defaults to $PG_CONNSTR, then libpq env vars (PGHOST, PGPORT, ...).")
        Process.quit(64)
    }
    val connstr = arg(2) ?? (getEnv("PG_CONNSTR") ?? "")

    println("Processing: " ++ file)
    flush()

    // ── Level 1: file access ────────────────────────────────────────────
    if not fileExists(file) then {
        fail1("SQL file not found: " ++ file)
    }

    if let Some(sql) = readFile(file) {
        // ── Level 2: connect + execute ──────────────────────────────────
        runSql(file, connstr, sql)
    } else {
        fail1("cannot open or read SQL file: " ++ file)
    }
}
