module pgcheck

import Stdlib.Core
import Stdlib.Db

// ---------------------------------------------------------------------------
// pgcheck — verify a specific PostgreSQL version is running and connectable
//
// Usage:
//   pgcheck <connstr> <expected_major>
//
// Example:
//   pgcheck "host=localhost dbname=postgres user=postgres password=secret" 16
// ---------------------------------------------------------------------------

fn main(): Unit [io] = {
    // ── Read arguments ────────────────────────────────────────────────────
    val connstr = arg(1) ?? "host=localhost dbname=postgres user=postgres"
    val wantMajor = parseInt(arg(2) ?? "16") ?? 16

    println(f"Connecting to PostgreSQL...")
    println(f"  connection string : {connstr}")
    println(f"  expected version  : {intToText(wantMajor)}.x")
    println("")

    // ── Connect ───────────────────────────────────────────────────────────
    val conn = dbConnect(connstr)

    if conn == 0 then {
        eprintln("FAIL  could not connect to server")
        eprintln(f"      {dbError(conn)}")
    } else {
        // ── Check version ─────────────────────────────────────────────────
        // dbServerVersion returns e.g. 160004 for PostgreSQL 16.4
        val versionNum = dbServerVersion(conn)
        val actualMajor = versionNum / 10000

        val banner = dbVersionString(conn)
        println(f"  server version    : {banner}")
        println(f"  version number    : {intToText(versionNum)}")
        println("")

        if actualMajor == wantMajor then {
            println(f"OK    PostgreSQL {intToText(actualMajor)} is running and connectable.")
        } else {
            eprintln(f"FAIL  expected major version {intToText(wantMajor)}, got {intToText(actualMajor)}.")
        }

        dbClose(conn)
    }
}
