module pgcheck

import Stdlib.Core
import Stdlib.Db

// ---------------------------------------------------------------------------
// pgcheck — verify a specific PostgreSQL version is running and connectable
//
// Usage:
//   pgcheck <connstr> <expected_version>
//
// Example:
//   pgcheck "host=localhost dbname=postgres user=postgres port=5432" 9.1
// ---------------------------------------------------------------------------

fn main(): Unit [io] = {
    // ── Read arguments ────────────────────────────────────────────────────
    val connstr   = arg(1) ?? "host=localhost dbname=postgres user=postgres port=5432"
    val verStr    = arg(2) ?? "9.1"

    // Parse "major.minor" by splitting on "." via indexOf + slice
    val dotPos    = Text.indexOf(verStr, ".") ?? Text.len(verStr)
    val wantMajor = parseInt(Text.slice(verStr, 0, dotPos)) ?? 9
    val wantMinor = parseInt(Text.slice(verStr, dotPos + 1, Text.len(verStr))) ?? 1

    println(f"Connecting to PostgreSQL...")
    println(f"  connection string : {connstr}")
    println(f"  expected version  : {intToText(wantMajor)}.{intToText(wantMinor)}")
    println("")

    // ── Connect ───────────────────────────────────────────────────────────
    val conn = dbConnect(connstr)

    if conn == 0 then {
        eprintln("FAIL  could not connect to server")
        eprintln(f"      {dbError(0)}")
    } else {
        // dbServerVersion returns e.g. 90105 for PostgreSQL 9.1.5
        val versionNum  = dbServerVersion(conn)
        val actualMajor = versionNum / 10000
        val actualMinor = (versionNum % 10000) / 100
        val actualPatch = versionNum % 100

        val banner = dbVersionString(conn)
        println(f"  server version    : {banner}")
        println(f"  version number    : {intToText(versionNum)}")
        println(f"  parsed version    : {intToText(actualMajor)}.{intToText(actualMinor)}.{intToText(actualPatch)}")
        println("")

        if actualMajor == wantMajor and actualMinor == wantMinor then {
            println(f"OK    PostgreSQL {intToText(actualMajor)}.{intToText(actualMinor)} is running and connectable.")
        } else {
            eprintln(f"FAIL  expected PostgreSQL {intToText(wantMajor)}.{intToText(wantMinor)}, got {intToText(actualMajor)}.{intToText(actualMinor)}.")
        }

        dbClose(conn)
    }
}
