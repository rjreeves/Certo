<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NexConsole.Views.AboutView"
             Background="#1a1a1a">
    <Grid>
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="20">

            <!-- Syntra banner -->
            <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                <Image x:Name="SyntraLogo" Width="200" Height="200"
                       RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <TextBlock Text="Nex Console"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#eeeeee"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- App identity card -->
            <Border Background="#242424" CornerRadius="8" Padding="24">
                <StackPanel Spacing="20">

                    <!-- Icon + name + version -->
                    <StackPanel Orientation="Horizontal" Spacing="20">
<StackPanel Spacing="4" VerticalAlignment="Center">
                            <Border Background="#1e3a2a" CornerRadius="4" Padding="8,3"
                                    HorizontalAlignment="Left">
                                <TextBlock x:Name="VersionLabel"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="#4caf7d"/>
                            </Border>
                            <TextBlock Text="Desktop operations console"
                                       FontSize="12" Foreground="#aaaaaa"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Divider -->
                    <Border Height="1" Background="#2a2a2a"/>

                    <!-- Dev stack -->
                    <StackPanel Spacing="12">
                        <TextBlock Text="Technology Stack"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#aaaaaa"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto"
                              Margin="0,4,0,0">

                            <StackPanel Grid.Column="0" Grid.Row="0" Spacing="2" Margin="0,0,0,12">
                                <TextBlock Text="UI FRAMEWORK" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="Avalonia 12" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="2" Margin="0,0,0,12">
                                <TextBlock Text="RUNTIME" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text=".NET 10" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="1" Spacing="2" Margin="0,0,0,12">
                                <TextBlock Text="LANGUAGE" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="C# 13 / MVVM" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="2" Margin="0,0,0,12">
                                <TextBlock Text="MVVM TOOLKIT" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="CommunityToolkit.Mvvm" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="2" Spacing="2" Margin="0,0,0,12">
                                <TextBlock Text="SECURITY DB" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="SQLite" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="2" Spacing="2" Margin="0,0,0,12">
                                <TextBlock Text="OPERATIONS DB" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="PostgreSQL (Npgsql)" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0" Grid.Row="3" Spacing="2">
                                <TextBlock Text="PASSWORD HASHING" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="BCrypt.Net-Next" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="3" Spacing="2">
                                <TextBlock Text="CREDENTIAL STORE" FontSize="10" Foreground="#aaaaaa"/>
                                <TextBlock Text="Windows DPAPI" FontSize="13" Foreground="#cccccc"/>
                            </StackPanel>

                        </Grid>
                    </StackPanel>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
    <TextBlock Text="© SyntrA 2026"
               FontSize="11" Foreground="#aaaaaa"
               HorizontalAlignment="Center"
               VerticalAlignment="Bottom"
               Margin="0,0,0,12"/>
    </Grid>
</UserControl>
