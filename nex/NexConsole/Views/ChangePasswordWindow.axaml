<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexConsole.ViewModels"
        x:Class="NexConsole.Views.ChangePasswordWindow"
        x:DataType="vm:ChangePasswordViewModel"
        Title="Change Password"
        Width="400" Height="440"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#2c2c2c">

    <Grid RowDefinitions="*,Auto,*">

        <Border Grid.Row="1"
                Background="#363636" CornerRadius="12"
                Padding="32,28" Margin="24,0"
                BoxShadow="0 8 32 0 #44000000">
            <StackPanel Spacing="0">

                <!-- Header -->
                <StackPanel Spacing="4" Margin="0,0,0,24">
                    <TextBlock Text="Change Password"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#eeeeee"/>
                    <TextBlock FontSize="12" Foreground="#888888"
                               TextWrapping="Wrap">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}Setting new password for {0}">
                                <Binding Path="Username"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>

                    <!-- First-login warning banner -->
                    <Border Background="#3a2a0a" CornerRadius="6"
                            Padding="12,8" Margin="0,8,0,0"
                            IsVisible="{Binding IsForced}">
                        <TextBlock Text="⚠  First login detected. You must set a new password before continuing."
                                   FontSize="11" Foreground="#f0a030"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- Current password (hidden for forced reset) -->
                <StackPanel Spacing="6" Margin="0,0,0,16"
                            IsVisible="{Binding !IsForced}">
                    <TextBlock Text="Current Password" FontSize="12" Foreground="#aaaaaa"/>
                    <TextBox Text="{Binding CurrentPassword}"
                             PasswordChar="●"
                             PlaceholderText="Enter current password"
                             Background="#2a2a2a"
                             Foreground="#eeeeee"
                             BorderBrush="#4a4a4a"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="12,10"
                             FontSize="13"/>
                </StackPanel>

                <!-- New password -->
                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <TextBlock Text="New Password" FontSize="12" Foreground="#aaaaaa"/>
                    <TextBox Text="{Binding NewPassword}"
                             PasswordChar="●"
                             PlaceholderText="At least 6 characters"
                             Background="#2a2a2a"
                             Foreground="#eeeeee"
                             BorderBrush="#4a4a4a"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="12,10"
                             FontSize="13"/>
                </StackPanel>

                <!-- Confirm password -->
                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <TextBlock Text="Confirm New Password" FontSize="12" Foreground="#aaaaaa"/>
                    <TextBox Text="{Binding ConfirmPassword}"
                             PasswordChar="●"
                             PlaceholderText="Repeat new password"
                             Background="#2a2a2a"
                             Foreground="#eeeeee"
                             BorderBrush="#4a4a4a"
                             BorderThickness="1"
                             CornerRadius="6"
                             Padding="12,10"
                             FontSize="13"/>
                </StackPanel>

                <!-- Error -->
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="12" Foreground="#e25c5c"
                           IsVisible="{Binding ErrorMessage.Length}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <!-- Buttons -->
                <Grid ColumnDefinitions="*,12,*">
                    <Button Grid.Column="0"
                            Command="{Binding CancelCommand}"
                            IsVisible="{Binding !IsForced}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#2a2a2a"
                            Foreground="#aaaaaa"
                            FontSize="13"
                            Padding="0,11"
                            CornerRadius="6"
                            BorderBrush="#4a4a4a"
                            BorderThickness="1">
                        Cancel
                    </Button>

                    <Button Grid.Column="2"
                            Command="{Binding ChangeCommand}"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Background="#4caf7d"
                            Foreground="#ffffff"
                            FontSize="13" FontWeight="SemiBold"
                            Padding="0,11"
                            CornerRadius="6"
                            BorderThickness="0">
                        <Panel>
                            <TextBlock Text="Set Password"
                                       IsVisible="{Binding !IsBusy}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Saving…"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.7"/>
                        </Panel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</Window>
