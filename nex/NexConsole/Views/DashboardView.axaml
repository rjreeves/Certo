<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexConsole.ViewModels"
             x:Class="NexConsole.Views.DashboardView"
             x:DataType="vm:DashboardViewModel"
             Background="#1a1a1a">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="20">

            <!-- Page title -->
            <TextBlock Text="Dashboard"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="#ffffff"/>

            <!-- Stat badges -->
            <UniformGrid Columns="4" HorizontalAlignment="Stretch">
                <UniformGrid.Styles>
                    <Style Selector="Border.badge">
                        <Setter Property="Background" Value="#242424"/>
                        <Setter Property="CornerRadius" Value="8"/>
                        <Setter Property="Padding" Value="16,14"/>
                        <Setter Property="Margin" Value="0,0,12,0"/>
                    </Style>
                    <Style Selector="TextBlock.label">
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Foreground" Value="#888888"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                    </Style>
                    <Style Selector="TextBlock.value">
                        <Setter Property="FontSize" Value="22"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Foreground" Value="#ffffff"/>
                    </Style>
                    <Style Selector="TextBlock.delta-up">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#4caf7d"/>
                    </Style>
                    <Style Selector="TextBlock.delta-down">
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Foreground" Value="#e25c5c"/>
                    </Style>
                </UniformGrid.Styles>

                <Border Classes="badge">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Active Orders"/>
                        <TextBlock Classes="value" Text="1,284"/>
                        <TextBlock Classes="delta-up" Text="↑ 8% vs last week"/>
                    </StackPanel>
                </Border>

                <Border Classes="badge">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Revenue (MTD)"/>
                        <TextBlock Classes="value" Text="$94,310"/>
                        <TextBlock Classes="delta-up" Text="↑ 12% vs last month"/>
                    </StackPanel>
                </Border>

                <Border Classes="badge">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Failed Jobs"/>
                        <TextBlock Classes="value" Text="3"/>
                        <TextBlock Classes="delta-down" Text="↑ 2 since yesterday"/>
                    </StackPanel>
                </Border>

                <Border Classes="badge" Margin="0">
                    <StackPanel>
                        <TextBlock Classes="label" Text="Uptime (30d)"/>
                        <TextBlock Classes="value" Text="99.7%"/>
                        <TextBlock Classes="delta-up" Text="↑ 0.1% vs prior period"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- System Resources -->
            <Border Background="#242424" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="System Resources"
                               FontSize="13" FontWeight="SemiBold" Foreground="#cccccc"/>

                    <!-- RAM -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding Resources.RamColor}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="RAM"
                                       FontSize="12" Foreground="#aaaaaa"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Resources.RamText}"
                                       FontSize="12" Foreground="#666666"/>
                        </Grid>
                        <ProgressBar Value="{Binding Resources.RamUsed}"
                                     Minimum="0" Maximum="100"
                                     Foreground="{Binding Resources.RamColor}"
                                     Background="#333333"
                                     Height="5" CornerRadius="3"/>
                    </StackPanel>

                    <!-- Disk -->
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Ellipse Width="8" Height="8"
                                     Fill="{Binding Resources.DiskColor}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Disk"
                                       FontSize="12" Foreground="#aaaaaa"
                                       Margin="10,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding Resources.DiskText}"
                                       FontSize="12" Foreground="#666666"/>
                        </Grid>
                        <ProgressBar Value="{Binding Resources.DiskUsed}"
                                     Minimum="0" Maximum="100"
                                     Foreground="{Binding Resources.DiskColor}"
                                     Background="#333333"
                                     Height="5" CornerRadius="3"/>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- Connection Probe -->
            <Border Background="#242424" CornerRadius="8" Padding="20"
                    IsVisible="{Binding Probe, Converter={x:Static ObjectConverters.IsNotNull}}">
                <StackPanel Spacing="14">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="Database Probe"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#cccccc" VerticalAlignment="Center"/>
                            <Border Background="#1e2e1e" CornerRadius="4" Padding="6,2">
                                <TextBlock Text="{Binding Probe.ConnectionName}"
                                           FontSize="11" Foreground="#4caf7d"/>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding Probe.RunCommand}"
                                Background="#1e3a5f" BorderThickness="0"
                                Foreground="#7ab3e0" FontSize="12"
                                Padding="14,6" CornerRadius="4">
                            Run
                        </Button>
                    </Grid>

                    <!-- Result rows -->
                    <Border Background="#1e1e1e" CornerRadius="6" Padding="14,12">
                        <StackPanel Spacing="12">

                            <!-- Version -->
                            <Grid ColumnDefinitions="110,*">
                                <TextBlock Text="Version"
                                           FontSize="12" Foreground="#666666"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Probe.Version}"
                                           FontSize="12" Foreground="#cccccc"
                                           TextWrapping="Wrap"/>
                            </Grid>

                            <!-- SELECT 1 -->
                            <Grid ColumnDefinitions="110,*">
                                <TextBlock Text="SELECT 1"
                                           FontSize="12" Foreground="#666666"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Probe.SelectOne}"
                                           FontSize="12" Foreground="#cccccc"/>
                            </Grid>

                            <!-- Schema -->
                            <Grid ColumnDefinitions="110,Auto,*">
                                <TextBlock Text="Schema"
                                           FontSize="12" Foreground="#666666"
                                           VerticalAlignment="Center"/>
                                <Ellipse Grid.Column="1"
                                         Width="8" Height="8"
                                         Fill="{Binding Probe.SchemaColor}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Probe.Schema}"
                                           FontSize="12"
                                           Foreground="{Binding Probe.SchemaColor}"/>
                            </Grid>

                        </StackPanel>
                    </Border>

                    <!-- Error -->
                    <Border IsVisible="{Binding Probe.HasError}"
                            Background="#2a1a1a" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="{Binding Probe.Error}"
                                   FontSize="11" Foreground="#e25c5c"
                                   TextWrapping="Wrap"/>
                    </Border>

                </StackPanel>
            </Border>

            <!-- Chart card -->
            <Border Background="#242424" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Orders — last 12 weeks"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#cccccc"
                                   VerticalAlignment="Center"/>
                        <Border Background="#1e3a5f" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="Weekly" FontSize="11" Foreground="#7ab3e0"/>
                        </Border>
                    </StackPanel>

                    <!-- Bar chart (12 bars, hardcoded mock heights) -->
                    <Canvas Height="140">
                        <!-- Horizontal grid lines -->
                        <Line Canvas.Left="0" Canvas.Top="0"   EndPoint="560,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="0" Canvas.Top="35"  EndPoint="560,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="0" Canvas.Top="70"  EndPoint="560,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="0" Canvas.Top="105" EndPoint="560,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="0" Canvas.Top="140" EndPoint="560,0"   Stroke="#2e2e2e" StrokeThickness="1"/>

                        <!-- Y-axis labels -->
                        <TextBlock Canvas.Left="0" Canvas.Top="-7"   Text="140" FontSize="10" Foreground="#555555" Width="28" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="28"   Text="105" FontSize="10" Foreground="#555555" Width="28" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="63"   Text="70"  FontSize="10" Foreground="#555555" Width="28" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="98"   Text="35"  FontSize="10" Foreground="#555555" Width="28" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="133"  Text="0"   FontSize="10" Foreground="#555555" Width="28" TextAlignment="Right"/>

                        <!-- Bars: x offsets start at 36, each bar 30px wide + 12px gap = 42px step -->
                        <!-- W1 height=60 → top=80 -->
                        <Rectangle Canvas.Left="36"  Canvas.Top="80"  Width="30" Height="60"  Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W2 height=90 → top=50 -->
                        <Rectangle Canvas.Left="78"  Canvas.Top="50"  Width="30" Height="90"  Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W3 height=75 → top=65 -->
                        <Rectangle Canvas.Left="120" Canvas.Top="65"  Width="30" Height="75"  Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W4 height=110 → top=30 -->
                        <Rectangle Canvas.Left="162" Canvas.Top="30"  Width="30" Height="110" Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W5 height=95 → top=45 -->
                        <Rectangle Canvas.Left="204" Canvas.Top="45"  Width="30" Height="95"  Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W6 height=125 → top=15 -->
                        <Rectangle Canvas.Left="246" Canvas.Top="15"  Width="30" Height="125" Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W7 height=80 → top=60 -->
                        <Rectangle Canvas.Left="288" Canvas.Top="60"  Width="30" Height="80"  Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W8 height=100 → top=40 -->
                        <Rectangle Canvas.Left="330" Canvas.Top="40"  Width="30" Height="100" Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W9 height=115 → top=25 -->
                        <Rectangle Canvas.Left="372" Canvas.Top="25"  Width="30" Height="115" Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W10 height=90 → top=50 -->
                        <Rectangle Canvas.Left="414" Canvas.Top="50"  Width="30" Height="90"  Fill="#2563a8" RadiusX="3" RadiusY="3"/>
                        <!-- W11 height=130 → top=10 -->
                        <Rectangle Canvas.Left="456" Canvas.Top="10"  Width="30" Height="130" Fill="#378ADD" RadiusX="3" RadiusY="3"/>
                        <!-- W12 (current, accent) height=120 → top=20 -->
                        <Rectangle Canvas.Left="498" Canvas.Top="20"  Width="30" Height="120" Fill="#378ADD" RadiusX="3" RadiusY="3"/>

                        <!-- Week labels -->
                        <TextBlock Canvas.Left="30"  Canvas.Top="145" Text="W1"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="72"  Canvas.Top="145" Text="W2"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="114" Canvas.Top="145" Text="W3"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="156" Canvas.Top="145" Text="W4"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="198" Canvas.Top="145" Text="W5"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="240" Canvas.Top="145" Text="W6"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="282" Canvas.Top="145" Text="W7"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="324" Canvas.Top="145" Text="W8"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="366" Canvas.Top="145" Text="W9"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="405" Canvas.Top="145" Text="W10" FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="447" Canvas.Top="145" Text="W11" FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="489" Canvas.Top="145" Text="W12" FontSize="10" Foreground="#555555"/>
                    </Canvas>

                </StackPanel>
            </Border>

            <!-- Line chart card -->
            <Border Background="#242424" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="Revenue — last 12 weeks"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#cccccc"
                                   VerticalAlignment="Center"/>
                        <Border Background="#1a3a2a" CornerRadius="4" Padding="6,2">
                            <TextBlock Text="USD" FontSize="11" Foreground="#4caf7d"/>
                        </Border>
                    </StackPanel>

                    <Canvas Height="140">
                        <!-- Grid lines -->
                        <Line Canvas.Left="36" Canvas.Top="0"   EndPoint="524,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="36" Canvas.Top="35"  EndPoint="524,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="36" Canvas.Top="70"  EndPoint="524,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="36" Canvas.Top="105" EndPoint="524,0"   Stroke="#2e2e2e" StrokeThickness="1"/>
                        <Line Canvas.Left="36" Canvas.Top="140" EndPoint="524,0"   Stroke="#2e2e2e" StrokeThickness="1"/>

                        <!-- Y-axis labels -->
                        <TextBlock Canvas.Left="0" Canvas.Top="-7"  Text="120k" FontSize="10" Foreground="#555555" Width="32" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="28"  Text="90k"  FontSize="10" Foreground="#555555" Width="32" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="63"  Text="60k"  FontSize="10" Foreground="#555555" Width="32" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="98"  Text="30k"  FontSize="10" Foreground="#555555" Width="32" TextAlignment="Right"/>
                        <TextBlock Canvas.Left="0" Canvas.Top="133" Text="0"    FontSize="10" Foreground="#555555" Width="32" TextAlignment="Right"/>

                        <!--
                            X positions: 40 + n*44 for n=0..11
                            Values (scaled to 140px canvas, max=120):
                            45,58,52,80,70,95,62,88,100,78,110,94
                            y = 140 - (v/120)*140
                        -->
                        <Polyline
                            Points="40,87.5 84,72.3 128,79.3 172,46.7 216,58.3 260,29.2 304,65.3 348,37.3 392,23.3 436,49.3 480,11.7 524,30.7"
                            Stroke="#4caf7d"
                            StrokeThickness="2"
                            StrokeLineCap="Round"/>

                        <!-- Dots at each data point -->
                        <Ellipse Canvas.Left="36"  Canvas.Top="83.5"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="80"  Canvas.Top="68.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="124" Canvas.Top="75.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="168" Canvas.Top="42.7"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="212" Canvas.Top="54.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="256" Canvas.Top="25.2"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="300" Canvas.Top="61.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="344" Canvas.Top="33.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="388" Canvas.Top="19.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <Ellipse Canvas.Left="432" Canvas.Top="45.3"  Width="8" Height="8" Fill="#4caf7d"/>
                        <!-- Last two dots accented white -->
                        <Ellipse Canvas.Left="476" Canvas.Top="7.7"   Width="8" Height="8" Fill="#ffffff"/>
                        <Ellipse Canvas.Left="520" Canvas.Top="26.7"  Width="8" Height="8" Fill="#ffffff"/>

                        <!-- X labels -->
                        <TextBlock Canvas.Left="34"  Canvas.Top="145" Text="W1"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="78"  Canvas.Top="145" Text="W2"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="120" Canvas.Top="145" Text="W3"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="162" Canvas.Top="145" Text="W4"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="204" Canvas.Top="145" Text="W5"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="246" Canvas.Top="145" Text="W6"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="288" Canvas.Top="145" Text="W7"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="330" Canvas.Top="145" Text="W8"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="372" Canvas.Top="145" Text="W9"  FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="411" Canvas.Top="145" Text="W10" FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="453" Canvas.Top="145" Text="W11" FontSize="10" Foreground="#555555"/>
                        <TextBlock Canvas.Left="495" Canvas.Top="145" Text="W12" FontSize="10" Foreground="#555555"/>
                    </Canvas>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
