<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexConsole.ViewModels"
             x:Class="NexConsole.Views.LogsView"
             x:DataType="vm:LogsViewModel"
             Background="#1a1a1a">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Logs" FontSize="20" FontWeight="SemiBold" Foreground="#ffffff"/>
                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Background="#1e3a5f" BorderThickness="0"
                        Foreground="#7ab3e0" FontSize="12"
                        Padding="14,6" CornerRadius="4">
                    ↻ Refresh
                </Button>
            </Grid>

            <Border Background="#242424" CornerRadius="8" Padding="20">
                <StackPanel Spacing="0">

                    <!-- Column headers -->
                    <Grid ColumnDefinitions="140,60,130,*" Margin="0,0,0,10">
                        <TextBlock Text="Timestamp" FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="1" Text="Level"   FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="2" Text="Source"  FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="3" Text="Message" FontSize="11" Foreground="#555555"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LogEntryViewModel">
                                <Border Background="#1e1e1e" CornerRadius="4"
                                        Padding="0,8" Margin="0,0,0,3">
                                    <Grid ColumnDefinitions="140,60,130,*" Margin="8,0">
                                        <TextBlock Text="{Binding TimestampText}"
                                                   FontSize="11" Foreground="#555555"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Level}"
                                                   FontSize="11"
                                                   Foreground="{Binding LevelBrush}"
                                                   FontFamily="Consolas,Menlo,monospace"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Source}"
                                                   FontSize="11" Foreground="#888888"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding Message}"
                                                   FontSize="12" Foreground="#cccccc"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
