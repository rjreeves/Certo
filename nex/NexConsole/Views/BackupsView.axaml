<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexConsole.ViewModels"
             x:Class="NexConsole.Views.BackupsView"
             x:DataType="vm:BackupsViewModel"
             Background="#1a1a1a">
    <ScrollViewer>
        <StackPanel Margin="28,24" Spacing="20">

            <TextBlock Text="Backups" FontSize="20" FontWeight="SemiBold" Foreground="#ffffff"/>

            <Border Background="#242424" CornerRadius="8" Padding="20">
                <StackPanel Spacing="0">

                    <!-- Header -->
                    <Grid ColumnDefinitions="*,80,120,120,100" Margin="0,0,0,10">
                        <TextBlock Text="Snapshot"  FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="1" Text="Size"     FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="2" Text="Created"  FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="3" Text="Verified" FontSize="11" Foreground="#555555"/>
                        <TextBlock Grid.Column="4" Text="State"    FontSize="11" Foreground="#555555"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Snapshots}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BackupSnapshotViewModel">
                                <Border Background="#1e1e1e" CornerRadius="6"
                                        Padding="14,11" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="*,80,120,120,100">
                                        <!-- Label + dot -->
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding StateBrush}"
                                                     VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Label}"
                                                       FontSize="13" Foreground="#eeeeee"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <!-- Size -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding SizeText}"
                                                   FontSize="12" Foreground="#aaaaaa"
                                                   VerticalAlignment="Center"/>
                                        <!-- Created -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding CreatedText}"
                                                   FontSize="12" Foreground="#666666"
                                                   VerticalAlignment="Center"/>
                                        <!-- Verified -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding VerifiedText}"
                                                   FontSize="12"
                                                   Foreground="{Binding VerifiedBrush}"
                                                   VerticalAlignment="Center"/>
                                        <!-- State badge -->
                                        <Border Grid.Column="4"
                                                Background="#2a2a2a" CornerRadius="4"
                                                Padding="8,3" HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}"
                                                       FontSize="11"
                                                       Foreground="{Binding StateBrush}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
