{
  "name": "certo-language",
  "displayName": "Certo",
  "description": "Syntax highlighting, diagnostics, hover, completion, and go-to-definition for the Certo language",
  "version": "0.1.0",
  "publisher": "rjreeves",
  "repository": {
    "type": "git",
    "url": "https://github.com/rjreeves/Certo"
  },
  "engines": { "vscode": "^1.75.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:certo"],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "certo",
        "aliases": ["Certo", "certo"],
        "extensions": [".cto", ".cto"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "certo",
        "scopeName": "source.cto",
        "path": "./syntaxes/certo.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Certo",
      "properties": {
        "certo.serverPath": {
          "type": "string",
          "default": "certo-lsp",
          "description": "Path to the certo-lsp binary. Defaults to 'certo-lsp' on PATH."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0"
  }
}
