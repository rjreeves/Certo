<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <PackageId>Certo.Native</PackageId>
    <!-- keep in step with crates/capi/Cargo.toml; the smoke test checks they agree -->
    <Version Condition="'$(Version)' == ''">0.2.0</Version>
    <Description>In-process Certo database compiler for .NET: SDL schemas, migrations, QL queries, SQL lowering and a migration runner (PostgreSQL, SQLite), as a P/Invoke binding plus the native library for each platform.</Description>
    <Authors>rjreeves</Authors>
    <Company>rjreeves</Company>
    <Copyright>Copyright (c) rjreeves</Copyright>
    <RepositoryUrl>https://github.com/rjreeves/Certo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/rjreeves/Certo/tree/master/packaging/dotnet</PackageProjectUrl>
    <!-- GitHub Packages links the package to the repository through RepositoryUrl; no license is declared
         because the repository has none yet: add PackageLicenseExpression when it does -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>false</IncludeSymbols>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>certo;database;migrations;schema;sql;sqlite;postgres</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- the native libraries are the point of the package; there is no managed-only use -->
    <NoPackageAnalysis>false</NoPackageAnalysis>
  </PropertyGroup>

  <ItemGroup>
    <!-- the binding lives next to the C header it mirrors -->
    <Compile Include="..\..\..\crates\capi\bindings\CertoNative.cs" Link="CertoNative.cs" />
    <!-- netstandard2.1 has no System.Text.Json of its own; net8.0 does -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" Condition="'$(TargetFramework)' == 'netstandard2.1'" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- native/<rid>/native/<library>, staged by stage-native.ps1, ends up in runtimes/<rid>/native/ -->
    <None Include="native\**\*" Pack="true" PackagePath="runtimes\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
