// Compiled once per provider: @NS@ is replaced by the generated namespace (Sample.Sqlite, Sample.Pg).
using System.Data.Common;
using @NS@;

namespace Check;

public static class Scenario_@NAME@
{
    public static async Task Run(DbConnection c, Action<bool, string> check)
    {
        var token = Guid.Parse("11111111-2222-3333-4444-555555555555");
        var ann = (await c.AddCustomerAsync("Ann", "a@x.com", new DateOnly(1990, 1, 2), token)).Single();
        var bob = (await c.AddCustomerAsync("Bob", null, null, null)).Single();
        check(ann.Id != bob.Id, "AddCustomerAsync returns the generated ids");

        var orders = await c.AddOrdersAsync(ann.Id, 10.00m, 25.50m);
        check(orders.Count == 2 && orders.All(o => o.Status == Status.New), "multi-row insert returns typed rows (enum default)");

        var over = await c.OrdersOverAsync(20m, null);
        check(over.Count == 1 && over[0].Customer == "Ann" && over[0].Total == 25.50m, "OrdersOverAsync with a null enum parameter");
        check(over[0].Shipped is null && over[0].Note is null && !over[0].Paid, "nullable columns come back as null, bool as bool");

        var changed = await c.SetStatusAsync(orders[1].Id, Status.Paid);
        check(changed == 1, "an update without returning gives the affected row count");
        var paid = await c.OrdersOverAsync(0m, Status.Paid);
        check(paid.Count == 1 && paid[0].Id == orders[1].Id && paid[0].Status == Status.Paid, "enum parameter and enum column round-trip");

        var stats = await c.CustomerStatsAsync();
        check(stats.Count == 2 && stats[0].Orders == 2 && stats[0].Spent == 35.50m, "aggregates: count as long, sum as decimal?");
        check(stats[1].Name == "Bob" && stats[1].Orders == 0 && stats[1].Spent is null, "sum over no rows is null");

        var found = await c.FindByTokenAsync(token);
        check(found.Count == 1 && found[0].Id == ann.Id && found[0].Born == new DateOnly(1990, 1, 2), "uuid parameter, date column");
        check((await c.FindByTokenAsync(Guid.NewGuid())).Count == 0, "no match is an empty list");

        var spenders = await c.BigSpendersAsync(30m);
        check(spenders.Count == 1 && spenders[0] == new BigSpendersRow("Ann"), "a query with a subquery");

        var removed = await c.RemoveByStatusAsync(Status.Paid);
        check(removed == 1, "delete returns the affected row count");
        check((await c.OrdersOverAsync(0m, null)).Count == 1, "...and the row is gone");

        // a transaction is honoured
        await using (var tx = await c.BeginTransactionAsync())
        {
            await c.AddCustomerAsync("Temp", null, null, null, tx);
            await tx.RollbackAsync();
        }
        check((await c.CustomerStatsAsync()).Count == 2, "the transaction argument is used (rollback undid the insert)");

        check(CertoQueries.OrdersOverSql.Contains("orders"), "the SQL is exposed as a constant");
    }
}
