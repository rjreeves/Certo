<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>use_dll_cs</AssemblyName>
  </PropertyGroup>

  <!-- Copy the Certo-built DLL next to the output so P/Invoke finds it at runtime. -->
  <ItemGroup>
    <None Include="..\add.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
