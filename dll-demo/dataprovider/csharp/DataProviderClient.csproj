<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>dataprovider_client</AssemblyName>
  </PropertyGroup>

  <!-- Copy the Certo DLL and its libpq dependency next to the exe. -->
  <ItemGroup>
    <None Include="..\dataprovider.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\libpq.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
