module C
extern "C" {
    fn rustReverse(s: Text): Text
}
type Reversed = { reversed: Text, length: Int }
fn reverseString(s: Text): Reversed [unsafe] = {
    val r = unsafe { rustReverse(s) }
    Reversed { reversed: r, length: Text.len(r) }
}
fn main(): Unit [io, unsafe] = {
    val out = reverseString("abcdef")
    println(out.reversed)
    println(intToText(out.length))
}
