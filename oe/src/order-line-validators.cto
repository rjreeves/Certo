module OrderLineValidators

validator OrderLineApplyDiscount for OrderLine errors OrderLineError {
    rule discount_cannot_make_line_negative {
        require discountAmount <= unitPrice
        else OrderLineError.DISCOUNT_EXCEEDS_LINE_VALUE
    }
    rule discount_percent_within_sales_limit {
        require UserIsAdmin or discountPercent <= 15
        else OrderLineError.DISCOUNT_EXCEEDS_SALES_LIMIT
    }
}
