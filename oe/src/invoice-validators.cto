module InvoiceValidators

validator InvoiceVoid for Invoice errors InvoiceError {
    rule invoice_void_admin_override {
        overrides invoice_void_within_window
        require UserIsAdmin
        else InvoiceError.INVOICE_VOID_OVERRIDE_NOT_ADMIN
    }
    rule invoice_void_within_window {
        require createdAt.age < InvoiceVoidWindow and InvoiceIsVoidable
        else InvoiceError.INVOICE_VOID_WINDOW_EXPIRED
    }
}
